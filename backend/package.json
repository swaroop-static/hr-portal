{
  "name": "hr-portal-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:push": "npx prisma db push",
    "db:push:postgres": "prisma db push --schema=prisma/schema.postgres.prisma",
    "migrate:dev": "prisma migrate dev --schema=prisma/schema.postgres.prisma",
    "migrate:prod": "prisma migrate deploy --schema=prisma/schema.postgres.prisma",
    "generate:postgres": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:seed": "node src/seed.js",
    "db:seed-tests": "node src/seedTests.js",
    "test:db": "node src/__tests__/createTestDb.mjs",
    "pretest": "npm run test:db",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ical-generator": "^11.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
